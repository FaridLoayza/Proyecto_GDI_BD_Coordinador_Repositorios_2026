; Copiar este archivo como config.ini y completar los datos reales.
; config.ini NO se sube a GitHub (contiene la contrasenia).
[postgresql]
host = localhost
port = 5432
dbname = bd_coordinador_repositorios
user = postgres
password = CAMBIAR_CLAVE
connect_timeout = 5

; Inicio de sesión con ORCID (OAuth). Datos de la app registrada en
; https://sandbox.orcid.org/developer-tools (pruebas) o orcid.org (producción).
; Tambien pueden darse con variables de entorno ORCID_CLIENT_ID, etc.
[orcid]
client_id = APP-XXXXXXXXXXXXXXXX
client_secret = CAMBIAR_SECRETO
; sandbox o production
environment = sandbox
; Debe coincidir EXACTAMENTE con la URI registrada en ORCID.
redirect_uri = http://127.0.0.1:8000/api/auth/orcid/callback
; Tras el login se vuelve automaticamente a la direccion desde la que se abrio
; el portal (127.0.0.1:5173 con Vite, 127.0.0.1:8000 con el .exe). Este valor
; solo se usa si esa direccion no es local; normalmente puede quedar vacio.
frontend_origin =

; Opcional: el panel de administrador (/admin) se conecta con este usuario de
; PostgreSQL (por ejemplo, un rol con permisos CRUD). Si se omite esta
; seccion, el panel usa la conexion de [postgresql].
; [postgresql_admin]
; user = admin_cris
; password = CAMBIAR_CLAVE_ADMIN

; Descarga automatica del uso de suscripciones (COUNTER 5 / SUSHI de Elsevier).
; APAGADA por defecto: mientras la biblioteca no entregue sus credenciales
; COUNTER, los reportes se importan como archivo en Historico > Importar datos.
[sushi]
habilitado = false
url_base = https://api.elsevier.com/sushi
customer_id =
requestor_id =
api_key =
